{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.aim.app",
  "icon": "dist/static/logo.png",
  "productName": "AIM",
  "asar": {
    "smartUnpack": false
  },
  "extraMetadata": {
    "main": "dist/main/index.js"
  },
  "files": [
    "dist/main/**/*",
    "dist/preload/**/*",
    "dist/knowledge-worker/**/*",
    "package.json",
    "!node_modules/**/*.map",
    "!node_modules/**/*.d.{ts,cts,mts}",
    "!node_modules/typeorm/browser{,/**/*}",
    "!node_modules/better-sqlite3/{src,deps,build}{,/**/*}",
    "!node_modules/@lancedb/lancedb-win32-x64-msvc{,/**/*}",
    "!node_modules/@xberg-io/xberg-win32-x64-msvc{,/**/*}"
  ],
  "electronLanguages": ["zh-CN"],
  "extraFiles": [
    {
      "from": "dist/renderer",
      "to": "static"
    },
    {
      "from": "dist/static",
      "to": "static",
      "filter": ["**/*", "!**/*.map"]
    },
    {
      "from": "appConf.cjs",
      "to": "appConf.cjs"
    },
    {
      "from": "default",
      "to": "default"
    }
  ],
  "extraResources": [
    {
      "from": "../electron/src/main/database/native",
      "to": "native",
      "filter": ["*.node"]
    },
    {
      "from": "node_modules/@lancedb/lancedb-win32-x64-msvc",
      "to": "native",
      "filter": ["*.node"]
    },
    {
      "from": "node_modules/@xberg-io/xberg-win32-x64-msvc",
      "to": "native",
      "filter": ["*.node", "*.dll"]
    },
    {
      "from": "dist/runtime/harness-builtin.asar",
      "to": "harness-builtin.asar"
    }
  ],
  "directories": {
    "output": "out"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "compression": "maximum",
  "beforePack": "scripts/build/check-output-idle.cjs",
  "afterPack": "scripts/build/verify-knowledge-native.cjs",
  "afterAllArtifactBuild": "scripts/build/report-size.cjs",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-installer.${ext}",
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": false,
    "differentialPackage": false
  }
}
