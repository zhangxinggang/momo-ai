{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.aim.app",
  "icon": "dist/static/logo.png",
  "productName": "AIM",
  "asar": true,
  "extraMetadata": {
    "main": "dist/main/index.js"
  },
  "files": [
    "dist/main/**/*",
    "dist/preload/**/*",
    "dist/knowledge-worker/**/*",
    "package.json",
    "!node_modules/**/*.map",
    "!node_modules/typeorm/browser{,/**/*}",
    "!node_modules/better-sqlite3/{src,deps}{,/**/*}"
  ],
  "electronLanguages": [
    "zh-CN"
  ],
  "extraFiles": [
    {
      "from": "dist/renderer",
      "to": "static"
    },
    {
      "from": "dist/static",
      "to": "static"
    },
    {
      "from": "appConf.cjs",
      "to": "appConf.cjs"
    },
    {
      "from": "default",
      "to": "default"
    }
  ],
  "extraResources": [
    {
      "from": "../electron/src/main/database/native",
      "to": "native",
      "filter": [
        "*.node"
      ]
    },
    {
      "from": "../../packages/momo-harness-runner/dist",
      "to": "harness-builtin"
    },
    {
      "from": "../../packages/momo-harness-runner/dist/node_modules",
      "to": "harness-builtin/node_modules"
    }
  ],
  "asarUnpack": [
    "**/*.node",
    "**/*.dll",
    "**/*.dylib",
    "**/*.so",
    "**/*.wasm"
  ],
  "directories": {
    "output": "out"
  },
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "compression": "normal",
  "afterPack": "scripts/build/verify-knowledge-native.cjs",
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "artifactName": "${productName}-${version}-windows-installer.${ext}",
    "oneClick": false,
    "perMachine": true,
    "allowToChangeInstallationDirectory": true,
    "runAfterFinish": false,
    "createDesktopShortcut": false,
    "differentialPackage": false
  }
}
